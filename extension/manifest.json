{
  "manifest_version": 3,
  "name": "Video2Study PDF",
  "version": "1.0.0",
  "description": "Convert educational YouTube videos into structured, visually attractive study PDFs.",
  "permissions": ["activeTab", "scripting", "storage", "downloads"],
  "host_permissions": ["https://*.youtube.com/*", "http://127.0.0.1:8000/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.youtube.com/watch*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}